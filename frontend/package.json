{
  "name": "lyre-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "predev": "node scripts/build-noise-wasm.mjs && node scripts/copy-ort-assets.mjs",
    "dev": "next dev",
    "build:noise-wasm": "node scripts/build-noise-wasm.mjs",
    "prebuild": "node scripts/build-noise-wasm.mjs && node scripts/copy-ort-assets.mjs",
    "build": "next build",
    "generate:webrpc": "go run -ldflags=\"-s -w -X github.com/webrpc/webrpc.VERSION=v0.36.0\" github.com/webrpc/webrpc/cmd/webrpc-gen@v0.36.0 -schema=../proto/lyre.ridl -target=typescript -client -out=./src/lib/lyre.gen.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.9.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "onnxruntime-web": "^1.30.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
